# Copy is optional: bin/compose regenerates .env on each run from the host.
# This file documents knobs you may set in the environment before invoking compose.
#
#   export PROJECT=/path/to/app
#   export IMAGE=arch-mise:dev
#   export CACHE_VOLUME=cache
#   ./bin/compose run --rm arch-mise bash -l
#
# Images are local-only (compose.yml pull_policy: never). Build with bin/build
# or bin/compose build — Compose will not pull arch-mise:dev from a registry.
#
# Compose project name: omit — Docker uses the directory basename (arch-mise).

IMAGE=arch-mise:dev
CACHE_VOLUME=cache
CACHE_ROOT=/cache
# IANA timezone (bin/compose detects host):
# TZ=America/Denver
# PostgreSQL client major (default from .mise.env / shell; empty skips install):
# POSTGRESQL_VERSION=18
# Absolute project path to mount at /work (bin/compose resolves PROJECT or $PWD):
# PROJECT_MOUNT=/home/you/src/my-app
# Sibling sample (optional warm target / PROJECT=…): ../arch-sample
